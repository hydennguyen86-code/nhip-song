# Bản mẫu cấu hình — KHÔNG chứa bí mật thật.
# Sao chép sang .env khi cần chạy với cấu hình khác mặc định.
# File .env đã nằm trong .gitignore — đừng commit nó.

# Cổng HTTP cho máy chủ (mặc định 8899).
PORT=8899

# Host lắng nghe. Mặc định 0.0.0.0 để iPhone cùng Wi-Fi mở được.
# Đặt 127.0.0.1 nếu chỉ dùng trên chính máy Mac.
HOST=0.0.0.0

# Thư mục lưu SQLite, secret.key và backup. Mặc định ./data.
# Đường dẫn tương đối sẽ được tính từ gốc repo.
NHIP_DATA_DIR=./data
