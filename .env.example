# Bản mẫu cấu hình — KHÔNG chứa bí mật thật.
# Sao chép sang .env khi cần chạy với cấu hình khác mặc định.
# File .env đã nằm trong .gitignore — đừng commit nó.

# Cổng HTTP cho máy chủ (mặc định 8899).
PORT=8899

# Host lắng nghe. Mặc định 0.0.0.0 để iPhone cùng Wi-Fi mở được.
# Đặt 127.0.0.1 nếu chỉ dùng trên chính máy Mac.
HOST=0.0.0.0

# Thư mục lưu SQLite, secret.key và backup. Mặc định ./data.
# Đường dẫn tương đối sẽ được tính từ gốc repo.
NHIP_DATA_DIR=./data

# --- AI (Claude) ---
# Chỉ điền trong .env thật, không bao giờ commit hay dán vào chat.
ANTHROPIC_API_KEY=

# Tuỳ chọn: bỏ dấu # ở dòng nào muốn đổi. Mặc định đã đủ dùng.
# Model cho giải thích hôm nay, hỏi đáp và tóm tắt tuần.
# AI_MODEL=claude-haiku-5-5
# Model cho phân tích quý, chỉ chạy khi bấm.
# AI_MODEL_DEEP=claude-sonnet-5-5
# Mức "suy nghĩ" của model: low (mặc định, nhanh, rẻ) | medium | high | none.
# AI_EFFORT=low
# AI_EFFORT_DEEP=medium
# Số lượt AI tối đa mỗi người mỗi ngày.
# AI_USER_DAILY_CALLS=15
# Số lượt AI tối đa cả server mỗi ngày.
# AI_GLOBAL_DAILY_CALLS=80
# Số lần phân tích quý (Sonnet) tối đa mỗi người mỗi tháng.
# AI_DEEP_PER_MONTH=2
# Giá USD mỗi triệu token đầu vào của Haiku 5.5, dùng để ước tính chi phí.
# AI_PRICE_IN=0.1
# Giá USD mỗi triệu token đầu ra của Haiku 5.5.
# AI_PRICE_OUT=0.5
# Giá USD mỗi triệu token đầu vào của Sonnet 5.5.
# AI_PRICE_DEEP_IN=2
# Giá USD mỗi triệu token đầu ra của Sonnet 5.5.
# AI_PRICE_DEEP_OUT=10

# --- Chỉ dùng nếu sau này chạy qua Cloudflare Tunnel (hiện không dùng) ---
# TRUST_PROXY=1
# COOKIE_SECURE=1
